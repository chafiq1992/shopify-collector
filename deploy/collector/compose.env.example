# -> /opt/collector/.env      (chmod 600, owned by deploy)
#
# Compose variable substitution ONLY. Nothing here reaches the application's
# environment — that is app.env. Keep the two apart.

# Image tag. deploy.sh rewrites this line; it is not edited by hand.
IMAGE_TAG=latest

# ── THE parallel-run switch ──────────────────────────────────────────
# 0 = Cloud Run owns the print queue (the only queue-consuming work in this
#     app). This deployment answers /pull with 503.
# 1 = this box owns it. Set only after Cloud Run has stopped serving.
#
# There is nothing else to hand over: this app has no schedulers and no cron.
WORKER_LOOPS=0

# ── Frontend build args (Vite inlines these at BUILD time) ───────────
# Changing any of them requires a rebuild, not a restart.
#
# Leave these pointing at the Cloud Run URL for the whole validation window.
# The print agents installed on the shop PCs are configured against that URL;
# repointing the bundle here while Cloud Run still owns the queue would have
# two deployments handing out the same print jobs.
VITE_PRINT_RELAY_URL=https://shopify-collector-985002633728.europe-west1.run.app
VITE_PRINT_RELAY_API_KEY=
VITE_PRINT_RELAY_PC_ID=pc-lab-1

# ── Resources (optional overrides) ───────────────────────────────────
# WEB_MEM=768m
# WEB_CPUS=2.0
