# -> /opt/collector/app.env   (chmod 600, owned by deploy)
#
# The application's runtime environment. deploy/pull-env.sh writes this file
# for real, straight from the live Cloud Run service over SSH, so no value is
# ever printed or written on the machine running it. This example documents
# the shape and — more importantly — the handful of values that must DIFFER
# from Cloud Run, which is the part a blind copy gets wrong.
#
# Unlike the other two apps on this box, almost nothing here comes from GCP
# Secret Manager: 35 of the 39 variables are plaintext env vars on the Cloud
# Run service. Only four are secret references:
#     SHOPIFY_PASSWORD           <- secret shopify_irrakids_secrete
#     IRRAKIDS_SHOPIFY_PASSWORD  <- secret SHOPIFY_ACCESS_TOKEN
#     GOOGLE_MAPS_API_KEY        <- secret GOOGLE_MAPS_API_KEY
#     OPENAI_API_KEY             <- secret OPENAI_API_KEY

# ── Identity / URLs ───────────────────────────────────────────────────
# BASE_URL is NOT cosmetic: shopify_oauth_routes.py builds the OAuth redirect
# as f"{BASE_URL}/api/shopify/oauth/callback", and that exact string must be
# whitelisted in each Shopify app. Changing it here without adding the new
# callback URL in every Shopify Partner dashboard breaks store installs.
# Keep the Cloud Run URL until cutover.
BASE_URL=https://shopify-collector-985002633728.europe-west1.run.app

# Append the test hostname so the UI served from it is an accepted origin.
# APPEND — do not replace, or the Cloud Run UI stops working mid-validation.
ALLOWED_ORIGINS=https://shopify-collector-985002633728.europe-west1.run.app,https://shopify-collector.chattbase.site

# The delivery app. It now runs on this same box and the two could talk over
# the Docker network as http://apex-web:8080 — but changing it during the
# parallel run would send this box's calls somewhere Cloud Run's do not go.
# Move it only at cutover, and note the trailing slash is load-bearing here:
# delivery_sync.py does rstrip("/") on it, so either form works.
DELVERY_BACKEND_URL=https://delvery-app-v3-985002633728.europe-west1.run.app/
DELVERY_ADMIN_TOKEN=

# ── Database ──────────────────────────────────────────────────────────
# The DIRECT Supabase host (project qkomhpjcxgnoyhjdvlgb), which is AAAA-only.
# This is why compose.yaml sets enable_ipv6: true on the internal network.
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.qkomhpjcxgnoyhjdvlgb.supabase.co:5432/postgres

# Cloud Run leaves these unset, so SQLAlchemy uses its defaults (pool_size 5,
# max_overflow 10) per instance, up to maxScale=5. One container here with one
# uvicorn worker is a much smaller footprint; stated explicitly so the ceiling
# is a decision rather than a default.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=300

# ── Auth ──────────────────────────────────────────────────────────────
# Carry VERBATIM. Regenerating it invalidates every issued session token, and
# both deployments must accept the same ones during the parallel run.
JWT_SECRET=
JWT_EXPIRES_MINUTES=720

# Leave the bootstrap token empty and the override off, exactly as Cloud Run
# has them. ADMIN_DEFAULT_* only act when no admin row exists, and one does.
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_BOOTSTRAP_ALLOW_EXISTING=0
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=

# ── Shopify ───────────────────────────────────────────────────────────
SHOPIFY_API_VERSION=2025-01
SHOPIFY_INVENTORY_API_VERSION=2026-07
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_OAUTH_SCOPES=
SHOPIFY_OAUTH_STORES=irranova,beitii,easygros
SHOPIFY_CLIENT_ID_beitii=
SHOPIFY_CLIENT_SECRET_beitii=
SHOPIFY_CLIENT_ID_easygros=
SHOPIFY_CLIENT_SECRET_easygros=
SHOPIFY_API_KEY=
SHOPIFY_PASSWORD=
IRRAKIDS_STORE_DOMAIN=nouralibas.myshopify.com
IRRAKIDS_SHOPIFY_PASSWORD=
IRRANOVA_STORE_DOMAIN=fdd92b-2e.myshopify.com
IRRANOVA_SHOPIFY_API_KEY=
IRRANOVA_SHOPIFY_WEBHOOK_SECRET=

# ── Print relay ───────────────────────────────────────────────────────
# The server half. The browser half of the same credentials is compiled into
# the bundle from /opt/collector/.env — they must agree.
API_KEY=
PC_ID_1=pc-lab-1
PC_SECRET_1=

# ── Behaviour flags ───────────────────────────────────────────────────
AUTO_TAGGING_ENABLED=1
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=

# NOT set here, deliberately — Compose sets them in compose.yaml so that no
# edit to this file can override a correctness constraint:
#     PORT, WORKER_LOOPS, K_SERVICE
#
# Dropped on purpose: RELAY_URL, pc_id, and the duplicate VITE_* entries the
# Cloud Run service carries (including one literally named
# "VITE_PRINT_RELAY_PC_ID " with a trailing space, which nothing can read).
# VITE_* are build args; setting them at runtime does nothing at all.
