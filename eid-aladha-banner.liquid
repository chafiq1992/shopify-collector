{% comment %}
  Eid al-Adha Banner for Shopify Dawn Theme
  Two-slide auto-rotating announcement bar:
    Slide 1: Same-day + 24h delivery + free shipping guarantee
    Slide 2: Cash on Delivery — pay only after you try & verify your purchase
{% endcomment %}

{% if section.settings.enable_banner or request.design_mode %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800;900&family=Playfair+Display:ital,wght@0,700;1,700&display=swap');

  #eid-wrapper-{{ section.id }} {
    --headline-size: {{ section.settings.headline_size }}px;
    --subtext-size: {{ section.settings.subtext_size }}px;
    --feature-size: {{ section.settings.feature_size }}px;
    --rotate-ms: {{ section.settings.slide_duration | times: 1000 }}ms;
  }

  .eid-wrapper-global {
    font-family: 'Inter', sans-serif;
    --gold: #fbbf24;
    --soft-gold: #fde68a;
    --deep-green: #064e3b;
    --emerald-dark: #022c22;
    --white: #ffffff;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .eid-bg {
    background: radial-gradient(circle at center, #065f46 0%, var(--emerald-dark) 100%);
    position: relative;
    overflow: hidden;
    border-bottom: 2px solid var(--gold);
    border-top: 2px solid var(--gold);
    display: block;
    width: 100%;
  }

  .eid-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.1;
    background-image: url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M40 10 L43 30 L60 30 L46 42 L52 60 L40 50 L28 60 L34 42 L20 30 L37 30 Z' fill='%23fbbf24' fill-opacity='1'/%3E%3C/svg%3E");
    pointer-events: none;
  }

  .eid-banner {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    box-sizing: border-box;
    padding: 14px 20px;
    color: var(--white);
    position: relative;
    z-index: 10;
    min-height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .eid-slides {
    position: relative;
    width: 100%;
    min-height: 60px;
  }

  .eid-slide {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    pointer-events: none;
    text-align: center;
  }

  .eid-slide.active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    position: relative;
  }

  .eid-headline {
    font-family: 'Playfair Display', serif;
    font-size: calc(var(--headline-size) * 0.8);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--gold);
    margin: 0;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.7);
  }

  .eid-subtext {
    font-size: calc(var(--subtext-size) * 0.85);
    color: var(--white);
    margin: 2px 0 0;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.6);
    line-height: 1.3;
  }

  .eid-features {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 14px;
    margin-top: 6px;
  }

  .eid-feature {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(0,0,0,0.4);
    border: 1px solid rgba(251, 191, 36, 0.4);
    padding: 5px 10px;
    border-radius: 999px;
    font-size: calc(var(--feature-size) * 0.85);
    font-weight: 800;
    color: var(--soft-gold);
    white-space: nowrap;
  }

  .eid-feature .eid-ico {
    font-size: calc(var(--feature-size) * 1.1);
    line-height: 1;
  }

  .eid-cod-line {
    font-size: calc(var(--feature-size) * 0.95);
    color: var(--soft-gold);
    font-weight: 700;
    margin-top: 4px;
    line-height: 1.35;
    max-width: 900px;
  }

  @media (min-width: 992px) {
    .eid-headline { font-size: var(--headline-size); }
    .eid-subtext { font-size: var(--subtext-size); }
    .eid-feature { font-size: var(--feature-size); padding: 6px 14px; }
    .eid-feature .eid-ico { font-size: calc(var(--feature-size) * 1.2); }
    .eid-cod-line { font-size: calc(var(--feature-size) * 1.05); }
    .eid-banner { padding: 14px 40px; }
  }

  .eid-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 8px;
  }

  .eid-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(253, 230, 138, 0.35);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .eid-dot.active {
    background: var(--gold);
    transform: scale(1.25);
  }

  /* Ambient particles */
  .eid-particle {
    position: fixed;
    top: -80px;
    pointer-events: none;
    z-index: 9999999;
    color: var(--gold);
    user-select: none;
    animation: eid-fall linear forwards;
    filter: drop-shadow(0 0 10px rgba(251, 191, 36, 0.9));
    opacity: 0;
  }

  @keyframes eid-fall {
    0%   { transform: translateY(0) rotate(0deg) translateX(0);  opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translateY(110vh) rotate(360deg) translateX(120px); opacity: 0; }
  }
</style>

<div id="eid-wrapper-{{ section.id }}" class="eid-wrapper-global eid-bg">
  <div class="eid-banner">
    <div class="eid-slides" id="eid-slides-{{ section.id }}">

      {%- comment -%} Slide 1: Delivery promises {%- endcomment -%}
      <div class="eid-slide active" data-slide="0">
        <h2 class="eid-headline">{{ section.settings.headline_1 | default: "EID AL-ADHA MUBARAK" }}</h2>
        <p class="eid-subtext">{{ section.settings.subheadline_1 | default: "Guaranteed Delivery This Eid Season" }}</p>
        <div class="eid-features">
          <span class="eid-feature"><span class="eid-ico">⚡</span>{{ section.settings.feature_same_day | default: "Same-Day Delivery" }}</span>
          <span class="eid-feature"><span class="eid-ico">🚚</span>{{ section.settings.feature_24h | default: "24-Hour Delivery" }}</span>
          <span class="eid-feature"><span class="eid-ico">🎁</span>{{ section.settings.feature_free | default: "Free Shipping" }}</span>
        </div>
      </div>

      {%- comment -%} Slide 2: Cash on Delivery {%- endcomment -%}
      <div class="eid-slide" data-slide="1">
        <h2 class="eid-headline">{{ section.settings.headline_2 | default: "CASH ON DELIVERY" }}</h2>
        <p class="eid-subtext">{{ section.settings.subheadline_2 | default: "Pay Only After You Try & Verify" }}</p>
        <div class="eid-cod-line">
          {{ section.settings.cod_description | default: "Receive your order, inspect it, try it on — and only then pay. Zero risk, total peace of mind." }}
        </div>
      </div>

    </div>
  </div>

  {% if section.settings.show_dots %}
  <div class="eid-dots" id="eid-dots-{{ section.id }}">
    <button class="eid-dot active" data-go="0" aria-label="Slide 1"></button>
    <button class="eid-dot" data-go="1" aria-label="Slide 2"></button>
  </div>
  {% endif %}
</div>

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const rotateMs  = {{ section.settings.slide_duration | times: 1000 }};
    const enableParticles = {{ section.settings.enable_ambient_effect | json }};

    const wrapper = document.getElementById('eid-wrapper-' + sectionId);
    if (!wrapper) return;

    const slides = wrapper.querySelectorAll('.eid-slide');
    const dots   = wrapper.querySelectorAll('.eid-dot');
    let idx = 0;
    let timer = null;

    function show(i) {
      idx = (i + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('active', k === idx));
      dots.forEach((d, k) => d.classList.toggle('active', k === idx));
    }

    function start() {
      stop();
      timer = setInterval(() => show(idx + 1), rotateMs);
    }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }

    dots.forEach(d => d.addEventListener('click', () => {
      show(parseInt(d.dataset.go, 10));
      start();
    }));

    wrapper.addEventListener('mouseenter', stop);
    wrapper.addEventListener('mouseleave', start);

    start();

    if (enableParticles) {
      const symbols = ['🌙', '⭐', '✨', '💫'];
      function createParticle() {
        if (document.hidden) return;
        const p = document.createElement('div');
        p.className = 'eid-particle';
        p.innerText = symbols[Math.floor(Math.random() * symbols.length)];
        const startX = Math.random() * window.innerWidth;
        const duration = 10 + Math.random() * 8;
        const size = 18 + Math.random() * 15;
        p.style.left = startX + 'px';
        p.style.animationDuration = duration + 's';
        p.style.fontSize = size + 'px';
        document.body.appendChild(p);
        setTimeout(() => p.remove(), duration * 1000);
      }
      setInterval(createParticle, 6000);
      for (let i = 0; i < 2; i++) setTimeout(createParticle, i * 2000);
    }
  })();
</script>

{% endif %}

{% schema %}
{
  "name": "Eid al-Adha Banner",
  "settings": [
    { "type": "header", "content": "General Settings" },
    {
      "type": "checkbox",
      "id": "enable_banner",
      "label": "Show banner",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_ambient_effect",
      "label": "Enable floating moons/stars on site",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show slide navigation dots",
      "default": true
    },
    {
      "type": "range",
      "id": "slide_duration",
      "min": 3,
      "max": 15,
      "step": 1,
      "unit": "s",
      "label": "Seconds per slide",
      "default": 6
    },

    { "type": "header", "content": "Slide 1 — Delivery Promise" },
    {
      "type": "text",
      "id": "headline_1",
      "label": "Headline",
      "default": "EID AL-ADHA MUBARAK"
    },
    {
      "type": "text",
      "id": "subheadline_1",
      "label": "Sub-headline",
      "default": "Guaranteed Delivery This Eid Season"
    },
    {
      "type": "text",
      "id": "feature_same_day",
      "label": "Feature 1 (Same-day)",
      "default": "Same-Day Delivery"
    },
    {
      "type": "text",
      "id": "feature_24h",
      "label": "Feature 2 (24-hour)",
      "default": "24-Hour Delivery"
    },
    {
      "type": "text",
      "id": "feature_free",
      "label": "Feature 3 (Free shipping)",
      "default": "Free Shipping"
    },

    { "type": "header", "content": "Slide 2 — Cash on Delivery" },
    {
      "type": "text",
      "id": "headline_2",
      "label": "Headline",
      "default": "CASH ON DELIVERY"
    },
    {
      "type": "text",
      "id": "subheadline_2",
      "label": "Sub-headline",
      "default": "Pay Only After You Try & Verify"
    },
    {
      "type": "textarea",
      "id": "cod_description",
      "label": "Description",
      "default": "Receive your order, inspect it, try it on — and only then pay. Zero risk, total peace of mind."
    },

    { "type": "header", "content": "Typography Sizes (Desktop)" },
    {
      "type": "paragraph",
      "content": "Sizes scale down automatically on mobile."
    },
    {
      "type": "range",
      "id": "headline_size",
      "min": 16, "max": 64, "step": 2, "unit": "px",
      "label": "Headline Size",
      "default": 30
    },
    {
      "type": "range",
      "id": "subtext_size",
      "min": 12, "max": 36, "step": 1, "unit": "px",
      "label": "Sub-headline Size",
      "default": 16
    },
    {
      "type": "range",
      "id": "feature_size",
      "min": 10, "max": 24, "step": 1, "unit": "px",
      "label": "Feature / Description Size",
      "default": 14
    }
  ],
  "presets": [
    { "name": "Eid al-Adha Banner" }
  ]
}
{% endschema %}
